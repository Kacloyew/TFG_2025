<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF5E6"
    android:padding="20dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_info_principal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="15dp">

            <View
                android:id="@+id/img_info_portada"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#D3D3D3"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_info_portada">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_leyendo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leyendo  " />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_leido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leído     " />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendiente" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_eliminar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#E6D5B8"
        android:text="Eliminar de la biblioteca"
        android:textColor="#5D4037"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_info_principal" />

</androidx.constraintlayout.widget.ConstraintLayout>