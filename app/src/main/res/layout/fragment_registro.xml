<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF5E6"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="30dp">

        <TextView
            android:id="@+id/tv_titulo_registro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Registro"
            android:textSize="26sp"
            android:textColor="#5D4037"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/et_reg_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@android:drawable/edit_text"
            android:hint="Nombre"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo_registro" />

        <EditText
            android:id="@+id/et_reg_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text"
            android:hint="Correo Electrónico"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/et_reg_nombre" />

        <EditText
            android:id="@+id/et_reg_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/et_reg_email" />

        <EditText
            android:id="@+id/et_reg_pass_rep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text"
            android:hint="Repetir contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/et_reg_pass" />

        <TextView
            android:id="@+id/lbl_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Fecha nacimiento"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_reg_pass_rep" />

        <LinearLayout
            android:id="@+id/layout_fecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/lbl_fecha">

            <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="DD" android:background="@android:drawable/edit_text" android:gravity="center"/>
            <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="MM" android:background="@android:drawable/edit_text" android:gravity="center" android:layout_marginHorizontal="10dp"/>
            <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="YYYY" android:background="@android:drawable/edit_text" android:gravity="center"/>
        </LinearLayout>

        <CheckBox
            android:id="@+id/check_terminos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Términos y condiciones"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_fecha" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>