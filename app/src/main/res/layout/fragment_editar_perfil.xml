<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF5E6">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Perfil"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_avatar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="45dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_edit_title">

            <ImageView
                android:id="@+id/img_edit_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#DCC6A0" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_cambiar_foto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cambiar foto"
            android:textColor="#8B7355"
            android:textSize="13sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_avatar" />

        <TextView
            android:id="@+id/lbl_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nombre"
            android:textColor="#5D4037"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_cambiar_foto" />

        <EditText
            android:id="@+id/et_edit_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:hint="Tu nombre"
            android:textColor="#5D4037"
            android:textColorHint="#C4A882"
            app:layout_constraintTop_toBottomOf="@id/lbl_nombre" />

        <TextView
            android:id="@+id/lbl_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sobre mí"
            android:textColor="#5D4037"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_edit_nombre" />

        <EditText
            android:id="@+id/et_edit_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:hint="Cuéntanos algo sobre ti"
            android:textColor="#5D4037"
            android:textColorHint="#C4A882"
            android:minLines="3"
            android:gravity="top"
            app:layout_constraintTop_toBottomOf="@id/lbl_bio" />

        <TextView
            android:id="@+id/lbl_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Web"
            android:textColor="#5D4037"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_edit_bio" />

        <EditText
            android:id="@+id/et_edit_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:hint="https://tuweb.com"
            android:textColor="#5D4037"
            android:textColorHint="#C4A882"
            android:inputType="textUri"
            app:layout_constraintTop_toBottomOf="@id/lbl_web" />

        <Button
            android:id="@+id/btn_guardar_cambios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="#DCC6A0"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textColor="#5D4037"
            app:layout_constraintTop_toBottomOf="@id/et_edit_web" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>