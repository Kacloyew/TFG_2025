<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/grafo_navegacion.xml"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tfg_2025.autenticacion.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registroFragment"
            app:destination="@id/registroFragment" />
        <action
            android:id="@+id/action_loginFragment_to_bibliotecaFragment"
            app:destination="@id/bibliotecaFragment" />
    </fragment>
    <fragment
        android:id="@+id/bibliotecaFragment"
        android:name="com.example.tfg_2025.biblioteca.BibliotecaFragment"
        android:label="BibliotecaFragment" >
        <action
            android:id="@+id/action_bibliotecaFragment_to_detalleLibroFragment"
            app:destination="@id/detalleLibroFragment" />
    </fragment>
    <fragment
        android:id="@+id/busquedaFragment"
        android:name="com.example.tfg_2025.busqueda.BusquedaFragment"
        android:label="BusquedaFragment" />
    <fragment
        android:id="@+id/detalleLibroFragment"
        android:name="com.example.tfg_2025.biblioteca.DetalleLibroFragment"
        android:label="DetalleLibroFragment" />
    <fragment
        android:id="@+id/editarPerfilFragment"
        android:name="com.example.tfg_2025.perfil.EditarPerfilFragment"
        android:label="EditarPerfilFragment" />
    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.tfg_2025.favoritos.FavoritosFragment"
        android:label="FavoritosFragment" />
    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.tfg_2025.perfil.PerfilFragment"
        android:label="PerfilFragment" >
        <action
            android:id="@+id/action_perfilFragment_to_editarPerfilFragment"
            app:destination="@id/editarPerfilFragment" />
    </fragment>
    <fragment
        android:id="@+id/registroFragment"
        android:name="com.example.tfg_2025.autenticacion.RegistroFragment"
        android:label="RegistroFragment" >
        <action
            android:id="@+id/action_registroFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registroFragment_to_bibliotecaFragment"
            app:destination="@id/bibliotecaFragment" />
        <action
            android:id="@+id/action_perfilFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>